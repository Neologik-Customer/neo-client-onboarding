# .gitignore for Neologik Onboarding Scripts

# Log files
*.log

# Configuration output files
*Configuration*.json

# Real predefined-input file (client-specific values)
inputs.json

# PowerShell temporary files
*.tmp
*.temp

# Azure credential cache
.azure/

# VS Code settings
.vscode/
*.code-workspace

# Windows thumbnail cache
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Sensitive information
secrets/
*.pfx
*.key
*.pem
*.crt

# Backup files
*.bak
*.backup
*~
NeologikCheckpoint.json

# JSON summaries written by Update-NeologikEnvironmentAccess.ps1 (never commit run output)
Neologik_EnvironmentAccess_*.json
# Pester -CI output
testResults.xml
