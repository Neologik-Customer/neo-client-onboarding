# .gitignore for Neologik Onboarding Scripts

# Log files
*.log

# Configuration output files
*Configuration*.json

# Real predefined-input file (client-specific values)
inputs.json
# Per-environment answer files copied from inputs-example.json (inputs-<env>.json)
inputs-*.json
!inputs-example.json

# PowerShell temporary files
*.tmp
*.temp

# Azure credential cache
.azure/

# VS Code settings
.vscode/
*.code-workspace

# Windows thumbnail cache
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Sensitive information
secrets/
*.pfx
*.key
*.pem
*.crt

# Backup files
*.bak
*.backup
*~
NeologikCheckpoint.json

# Summary files written by Update-NeologikEnvironmentAccess.ps1
Neologik_EnvironmentAccess_*.json
# Grants files supplied for Update-NeologikEnvironmentAccess.ps1
agent-grants-*.json
mailbox-grants-*.json

# Test output
testResults.xml
